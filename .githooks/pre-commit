#!/bin/bash
# Two gates, both failing closed: gitleaks over the staged changes, then publish-hygiene over
# the tracked tree. The personal terms are local and untracked, so this hook is where they act;
# CI runs the same script with the generic shapes only.
#
# gitleaks comes from PATH or two known install locations, and a missing scanner refuses the
# commit, because absent must not look like clean. Needs gitleaks >= 8.19 for `git --staged`.

REPO_ROOT="$(git rev-parse --show-toplevel)"

GITLEAKS="$(command -v gitleaks || true)"
for candidate in /home/linuxbrew/.linuxbrew/bin/gitleaks "$HOME/.local/bin/gitleaks"; do
    if [ -z "$GITLEAKS" ] && [ -x "$candidate" ]; then
        GITLEAKS="$candidate"
    fi
done

if [ -z "$GITLEAKS" ] || [ ! -x "$GITLEAKS" ]; then
    echo ""
    echo "gitleaks not found, refusing to commit."
    echo "  install: brew install gitleaks"
    echo ""
    exit 1
fi

echo "Running gitleaks scan on staged changes..."
"$GITLEAKS" git --staged --verbose
status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "gitleaks found potential secrets in staged files."
    echo "  Remove the credential, or if it is a false positive add it to .gitleaksignore."
    echo "  To bypass this once (not recommended): git commit --no-verify"
    echo ""
    exit 1
fi

echo "No secrets detected."

echo "Running publish-hygiene scan on the tracked tree..."
if ! bash "$REPO_ROOT/scripts/publish-hygiene.sh"; then
    echo ""
    echo "publish-hygiene refused this commit: the tracked tree carries identity or infrastructure."
    echo "  Genericize the offending lines, or move a term that belongs only on this machine"
    echo "  into scripts/hygiene-patterns.local.txt."
    echo "  To bypass this once (not recommended): git commit --no-verify"
    echo ""
    exit 1
fi

exit 0
